#!/usr/bin/env python3

import subprocess
import shutil
from collections import defaultdict


def main():
    result = subprocess.run(
        ["git", "tag", "--sort=version:refname"],
        capture_output=True,
        text=True,
        check=True
    )

    tags = result.stdout.splitlines()

    if not tags:
        print("No Git tags found.")
        return

    groups = defaultdict(list)

    for tag in tags:
        groups[tag[:3].lower()].append(tag)

    terminal_width = shutil.get_terminal_size().columns
    gap = 3

    # Build group blocks.
    blocks = []

    for initial, items in groups.items():
        width = max(len(tag) for tag in items) + 2
        width = max(width, len(initial) + 4)

        lines = [
            f" {initial.upper()} "
            + "─" * (width - len(initial) - 3)
        ]

        lines.extend(f" {tag:<{width - 2}}" for tag in items)

        blocks.append((width, lines))

    # Arrange blocks horizontally, filling each row.
    row = []
    row_width = 0
    rows = []

    for block in blocks:
        width, lines = block

        if row and row_width + gap + width > terminal_width:
            rows.append(row)
            row = []
            row_width = 0

        row.append(block)
        row_width += width + (gap if len(row) > 1 else 0)

    if row:
        rows.append(row)

    # Render each row of blocks.
    for row in rows:
        height = max(len(lines) for _, lines in row)

        for i in range(height):
            output = []

            for width, lines in row:
                output.append(
                    lines[i].ljust(width) if i < len(lines)
                    else " " * width
                )

            print((" " * gap).join(output).rstrip())

        print()


if __name__ == "__main__":
    main()
