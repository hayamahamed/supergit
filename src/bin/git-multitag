#!/usr/bin/env sh

if [[ $# == 0 ]]; then
	echo "From Gitera
usage:
  git multitag <tag1> <tag2> ... <tn>	  --> tag multiple tags at current commit.
  git mutitag push <tag1> <tag2> ... <tn> --> Push multiple tags at onces
  
NOTE: For some obvious reasons tagging push as a the first tag in multitag isn't supported."

elif [[ $1 == 'push' ]]; then
	shift
	REMOTE=$1
	shift
	for i in $@; do
		git push $REMOTE $i
	done
else
	for i in $@; do
		git tag $i
	done
fi

